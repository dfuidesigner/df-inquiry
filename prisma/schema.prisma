generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum AdminRole {
  SUPER_ADMIN
  MANAGER
  SALES
}

enum PermissionKey {
  VIEW_ALL_LEADS
  VIEW_ASSIGNED_LEADS

  CREATE_LEAD
  EDIT_LEAD
  DELETE_LEAD
  MANAGE_LEAD_CATEGORIES
  ASSIGN_LEAD

  CREATE_ADMIN
  EDIT_ADMIN
  DELETE_ADMIN

  VIEW_REPORTS
  EXPORT_LEADS
}

model Admin {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String

  role     AdminRole @default(SALES)
  isActive Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions   Permission[]
  assignedLeads Inquiry[]
  adminTasks    AdminTask[]

  reassignmentsFrom LeadReassignment[] @relation("ReassignmentFromAdmin")
  reassignmentsTo   LeadReassignment[] @relation("ReassignmentToAdmin")
  reassignmentsMade LeadReassignment[] @relation("ReassignmentByAdmin")

  @@map("admins")
}

model Permission {
  id String @id @default(cuid())

  adminId String
  admin   Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  permission PermissionKey

  createdAt DateTime @default(now())

  @@unique([adminId, permission])
  @@map("permissions")
}

model LeadCategory {
  id    String  @id @default(cuid())
  name  String  @unique
  color String? @default("#64748b")

  leads Inquiry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lead_categories")
}

model Inquiry {
  id String @id @default(cuid())

  name  String
  email String
  phone String

  service String
  message String? @db.Text

  company  String?
  location String?

  status      String? @default("NEW")
  rewardValue Float?

  source       String?
  utm_source   String?
  utm_medium   String?
  utm_campaign String?
  utm_content  String?
  utm_term     String?

  assignedToId String?
  assignedTo   Admin?        @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  categoryId   String?
  category     LeadCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  actions LeadAction[]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  adminTasks AdminTask[]

  reassignments LeadReassignment[]

  @@index([assignedToId])
  @@index([status])
  @@index([categoryId])
  @@index([createdAt])
  @@map("inquiry")
}

model LeadAction {
  id String @id @default(cuid())

  inquiryId String
  inquiry   Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  actionType String
  outcome    String
  note       String? @db.Text

  createdAt DateTime @default(now())

  @@index([inquiryId])
  @@index([createdAt])
  @@map("lead_actions")
}

enum AdminTaskType {
  CALL
  CLIENT_MEETING
  FOLLOW_UP
  DEMO
  PROPOSAL
  DOCUMENTATION
  INTERNAL_WORK
  OTHER
}

enum AdminTaskStatus {
  DONE
  IN_PROGRESS
  BLOCKED
}

model AdminTask {
  id String @id @default(cuid())

  adminId String
  admin   Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  leadId String?
  lead   Inquiry? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  taskType AdminTaskType
  status   AdminTaskStatus @default(DONE)

  title       String
  clientName  String?
  clientPhone String?
  clientEmail String?
  description String? @db.Text
  outcome     String? @db.Text

  durationMinutes Int
  taskDate        DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminId])
  @@index([leadId])
  @@index([taskDate])
  @@index([taskType])
  @@map("admin_tasks")
}

enum CareerSubmissionStatus {
  NEW
  REVIEWING
  SHORTLISTED
  INTERVIEW
  REJECTED
  HIRED
}

model CareerSubmission {
  id String @id @default(cuid())

  name  String
  email String
  phone String

  linkedin        String?
  role            String
  experienceYears Float?
  currentCompany  String?
  location        String?

  coverLetter    String? @db.Text
  resumeUrl      String?
  resumeFileName String?

  status    CareerSubmissionStatus @default(NEW)
  adminNote String?                @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([role])
  @@index([createdAt])
  @@map("career_submissions")
}

model LeadReassignment {
  id String @id @default(cuid())

  inquiryId String
  inquiry   Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  fromAdminId String?
  fromAdmin   Admin?  @relation("ReassignmentFromAdmin", fields: [fromAdminId], references: [id], onDelete: SetNull)

  toAdminId String
  toAdmin   Admin  @relation("ReassignmentToAdmin", fields: [toAdminId], references: [id], onDelete: Cascade)

  reassignedById String
  reassignedBy   Admin  @relation("ReassignmentByAdmin", fields: [reassignedById], references: [id], onDelete: Cascade)

  previousStatus String?
  note           String? @db.Text

  createdAt DateTime @default(now())

  @@index([inquiryId])
  @@index([fromAdminId])
  @@index([toAdminId])
  @@map("lead_reassignments")
}
