generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum AdminRole {
  SUPER_ADMIN
  MANAGER
  SALES
}

enum PermissionKey {
  VIEW_ALL_LEADS
  VIEW_ASSIGNED_LEADS

  CREATE_LEAD
  EDIT_LEAD
  DELETE_LEAD

  ASSIGN_LEAD

  CREATE_ADMIN
  EDIT_ADMIN
  DELETE_ADMIN

  VIEW_REPORTS
  EXPORT_LEADS
}

model Admin {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String

  role     AdminRole @default(SALES)
  isActive Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions   Permission[]
  assignedLeads Inquiry[]
  adminTasks    AdminTask[]

  @@map("admins")
}

model Permission {
  id String @id @default(cuid())

  adminId String
  admin   Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  permission PermissionKey

  createdAt DateTime @default(now())

  @@unique([adminId, permission])
  @@map("permissions")
}

model Inquiry {
  id String @id @default(cuid())

  name  String
  email String
  phone String

  service String
  message String? @db.Text

  status      String? @default("NEW")
  rewardValue Float?

  source       String?
  utm_source   String?
  utm_medium   String?
  utm_campaign String?
  utm_content  String?
  utm_term     String?

  assignedToId String?
  assignedTo   Admin?  @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  actions LeadAction[]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  adminTasks AdminTask[]

  @@index([assignedToId])
  @@index([status])
  @@index([createdAt])
  @@map("inquiry")
}

model LeadAction {
  id String @id @default(cuid())

  inquiryId String
  inquiry   Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  actionType String
  outcome    String
  note       String? @db.Text

  createdAt DateTime @default(now())

  @@index([inquiryId])
  @@index([createdAt])
  @@map("lead_actions")
}

enum AdminTaskType {
  CALL
  CLIENT_MEETING
  FOLLOW_UP
  DEMO
  PROPOSAL
  DOCUMENTATION
  INTERNAL_WORK
  OTHER
}

enum AdminTaskStatus {
  DONE
  IN_PROGRESS
  BLOCKED
}

model AdminTask {
  id String @id @default(cuid())

  adminId String
  admin   Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  leadId String?
  lead   Inquiry? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  taskType AdminTaskType
  status   AdminTaskStatus @default(DONE)

  title       String
  clientName  String?
  clientPhone String?
  clientEmail String?
  description String? @db.Text
  outcome     String? @db.Text

  durationMinutes Int
  taskDate        DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminId])
  @@index([leadId])
  @@index([taskDate])
  @@index([taskType])
  @@map("admin_tasks")
}
