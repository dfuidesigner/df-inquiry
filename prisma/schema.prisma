model Prospect {
  id String @id @default(cuid())

  name  String
  email String
  phone String

  categoryId String?
  category   LeadCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull) // CHANGED from ProspectCategory

  note   String? @db.Text
  source String? @default("Import")

  convertedLeadId String?   @unique
  convertedLead   Inquiry?  @relation(fields: [convertedLeadId], references: [id], onDelete: SetNull)
  convertedAt     DateTime?
  convertedById   String?
  convertedBy     Admin?    @relation("ProspectConvertedBy", fields: [convertedById], references: [id], onDelete: SetNull)

  importedById String?
  importedBy   Admin?  @relation("ProspectImportedBy", fields: [importedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([convertedLeadId])
  @@index([createdAt])
  @@map("prospects")
}
